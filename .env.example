# Required: create at https://app.pinecone.io/
PINECONE_API_KEY=replace-with-your-key

# Application configuration
PINECONE_INDEX=lawbot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LEGAL_CSV_PATH=Data/bdlaws_ds_formatted.csv
RETRIEVAL_TOP_K=3
SECRET_KEY=replace-with-a-long-random-value

# Optional local server settings
HOST=127.0.0.1
PORT=8080
FLASK_DEBUG=false
LOG_LEVEL=INFO
LOG_CHAT_CONTENT=false
